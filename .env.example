# SIFWAKU HeatWatch — Environment Variables
# Copy this file to .env and fill in values. NEVER commit .env.

# Database (SQLite for student simplicity; switch to PostgreSQL for production)
DATABASE_URL=sqlite:///./data/sifwaku_heatwatch.db
# DATABASE_URL=postgresql://user:password@localhost:5432/sifwaku_heatwatch

# Weather providers (leave blank if not used)
# OpenWeatherMap: https://openweathermap.org/api — free tier requires key
OPENWEATHERMAP_API_KEY=

# Visual Crossing: https://www.visualcrossing.com/weather-api — free tier requires key
VISUALCROSSING_API_KEY=

# Open-Meteo: no key required for non-commercial use
# (rate limit ~10,000 calls/day non-commercial)

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Default location (Lusaka, Zambia)
DEFAULT_LATITUDE=-15.4167
DEFAULT_LONGITUDE=28.2833
DEFAULT_LOCATION_NAME=Lusaka
DEFAULT_COUNTRY=Zambia
